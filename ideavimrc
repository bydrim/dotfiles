"" .ideavimrc is a configuration file for IdeaVim plugin. It uses
""   the same commands as the original .vimrc configuration.
"" You can find a list of commands here: https://jb.gg/h38q75
"" Find more examples here: https://jb.gg/share-ideavimrc

" https://github.com/JetBrains/ideavim/blob/master/doc/IdeaVim%20Plugins.md
" https://github.com/JetBrains/ideavim/discussions/303#discussioncomment-12591982


let mapleader = ' '
let maplocalleader = ' '

" Start searching and highlighting as typing
set incsearch
" Enable Which-Key plugin
set which-key
" Do not hide Which-Key popup
set notimeout
" Enable search highlighting
set hls
" Case-insensitive search
set ignorecase
" case-sensitive search if search query includes capital letter
set smartcase
" Relative line numbers by default
set relativenumber
" yanking to-from clipboard
set clipboard+=unnamedplus
" minimum number of lines above and below the cursor
set scrolloff=10
" Case-insensitive searching UNLESS \C or one or more capital letters in the search term
set ignorecase
set smartcase
" Decrease mapped sequence wait time
set timeoutlen=300
" Show which line your cursor is on
set cursorline

" Turn off search highlight till search again
nnoremap <Esc> :nohlsearch<CR>

" config edit or source
nmap <leader>ce :e ~/.ideavimrc<CR>
nmap <leader>cs :source ~/.ideavimrc<CR>

" previous/next buffer
nnoremap [b :bp<CR>
nnoremap ]b :bn<CR>

" GoTo tab
nmap <leader>1 <Action>(GoToTab1)
nmap <leader>2 <Action>(GoToTab2)
nmap <leader>3 <Action>(GoToTab3)
nmap <leader>4 <Action>(GoToTab4)
nmap <leader>5 <Action>(GoToTab5)
nmap <leader>6 <Action>(GoToTab6)
nmap <leader>7 <Action>(GoToTab7)
nmap <leader>8 <Action>(GoToTab8)
nmap <leader>9 <Action>(GoToTab9)

" Move easier between windows
nnoremap <C-h> <C-w><C-h>
nnoremap <C-l> <C-w><C-l>
nnoremap <C-j> <C-w><C-j>
nnoremap <C-k> <C-w><C-k>

" search
nmap <leader>sf <Action>(GotoFile)
nmap <leader>sg <Action>(FindInPath)

" format file
nmap <leader>f <Action>(ReformatCode)

" LSP keymaps
nmap grn <Action>(RenameElement)
" goto definition
nmap grd <Action>(GotoDeclaration)
nmap grD <Action>(GotoTypeDeclaration)
nmap gri <Action>(GotoImplementation)
nmap grr <Action>(FindUsages)
" workspace symbols
nmap gW <Action>(GotoSymbol)
nmap gra <Action>(GotoAction)

" dap
nmap <leader>dt <Action>(ToggleLineBreakpoint)
" [S]et breakpoint (consistency with nvim). sets condition but doesn't create a breakpoint
nmap <leader>ds <Action>(EditBreakpoint)

" accept with c-y instead of tab or enter
imap <C-y> <Action>(EditorChooseLookupItem)

" Highlight copied text
Plug 'machakann/vim-highlightedyank'

" Commentary plugin
Plug 'tpope/vim-commentary'

" File explorer
Plug 'preservim/nerdtree'
" '<leader>e' opens fileexplorer, 'q' closes it and escapes focuses back to editor
nnoremap <leader>e :NERDTreeToggle<CR>
" nnoremap <leader>n :NERDTreeFocus<CR>
nnoremap <C-n> :NERDTree<CR>
nnoremap <C-f> :NERDTreeFind<CR>
