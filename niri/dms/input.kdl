// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    mouse {
        accel-speed 1.0
        accel-profile "flat"
    }
    touchpad {
        tap
        accel-speed 1.0
        accel-profile "flat"
        natural-scroll
        dwt
        scroll-method "two-finger"
    }
    keyboard {
        xkb {
            layout "us(altgr-intl),tr"
            options "grp:win_space_toggle"
        }
    }
}

